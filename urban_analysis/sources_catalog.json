    "abfrage": {
      "_hinweis": "Was die Overpass-Abfrage holt (M10a). 'schluessel' = alle Merkmale, nach denen das OSM-Profil in mapping_rules.json einordnet, außer 'boundary' (Grenz-Relationen reichen weit über das Gebiet hinaus und machen den Download riesig). Relationen nur als Flächen (type=multipolygon). Ein Test hält die Liste mit dem Profil in Einklang.",
      "zeitlimit_s": 300,
      "schluessel": [
        "amenity", "barrier", "building", "building:part", "highway", "landuse", "leisure",
        "man_made", "natural", "place", "power", "public_transport", "railway", "shop",
        "water", "waterway"
      ],
      "ohne_schluessel": ["boundary"],
      "rohdatei": "osm_{datum}.osm",
      "geopackage": "osm_{datum}.gpkg"
    },
    "regeln": {
      "_hinweis": "Nutzungsregeln des öffentlichen Overpass-Servers (overpass-api.de, Stand 2026-11).",
      "max_abfragen_pro_tag": 10000,
      "max_datenmenge_pro_tag_gb": 1,
      "standard_zeitlimit_s": 180,
      "standard_speicher_mib": 512,
      "bei_ueberlastung": "HTTP 429 (zu viele Anfragen) oder 504 (zu groß) – verständliche Meldung, kein automatisches Wiederholen in Schleife"
    }
  },

